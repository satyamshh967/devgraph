# ==========================================
# Developer Knowledge Graph Platform Config
# ==========================================

# Port Configuration
PORT=5000
NLP_SERVICE_URL=http://127.0.0.1:8000

# Neo4j Aura Database Credentials (Optional)
# If left blank, the platform automatically runs in Dual-Mode
# utilizing the high-performance In-Memory Graph Engine.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-password

# GitHub Personal Access Token (Optional)
# Increases rate limits for live GitHub profile imports
GITHUB_TOKEN=ghp_your_github_token_here
